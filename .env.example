# Secrets only (API keys). Do not commit your .env.
#
# Model selection, model names, embedding dimensions and base URLs live in
# sd-agentic-rag.cfg (USE_OLLAMA_MODELS, *_EMBEDDING_MODEL, *_CHAT_MODEL,
# *_EMBEDDING_MODEL_DIMM, OLLAMA_BASE_URL, OPENAI_BASE_URL). .env is loaded
# first, so a model setting here would silently override the cfg; one found
# here is reported as a warning at startup.

# OpenAI (used when USE_OLLAMA_MODELS=false)
OPENAI_API_KEY=your-openai-api-key-here

# Ollama (only if your Ollama endpoint requires authentication)
# OLLAMA_API_KEY=
